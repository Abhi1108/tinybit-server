# ============================================================================
# TinyBit Server Configuration Template
# ============================================================================
# Copy this file to .env and fill in your values
# .env is gitignored and should NOT be committed
# 
# For local development: use STORAGE_TYPE=filesystem
# For production: use STORAGE_TYPE=s3
# ============================================================================

# Environment
NODE_ENV=development
PORT=5000

# Payments — dev-mode bypass. When 'true', POST /api/payments/dev-complete fakes a
# successful renewal payment (no Razorpay call) so onboarding is testable before real
# checkout ships on mobile. Must be unset/false in production.
ALLOW_DEV_PAYMENTS=true

# Razorpay (required for real checkout; NOT required for ALLOW_DEV_PAYMENTS bypass)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Database Configuration ────────────────────────────────────────────────
# For local development: use Docker MySQL
# For production: use AWS RDS or similar managed database
DB_DRIVER=mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=tinybit

# ─── JWT & Authentication ────────────────────────────────────────────────
# JWT_SECRET: Change this in production! Use a strong random string
# Generate: openssl rand -base64 32
JWT_SECRET=dev-secret-key-change-in-production
JWT_ISSUER=https://tinybit.app/auth
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_DAYS=30

# ─── Storage Configuration ────────────────────────────────────────────────
# STORAGE_TYPE options:
#   - filesystem: For local development (files stored in ./uploads/)
#   - s3:        For production (files stored in AWS S3)
#
# LOCAL DEVELOPMENT:
STORAGE_TYPE=filesystem
STORAGE_BASE_URL=http://localhost:5000/api

# PRODUCTION (only needed if STORAGE_TYPE=s3):
# S3_BUCKET=tinybit-media-prod
# S3_REGION=ap-northeast-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# ─── Firebase Configuration ──────────────────────────────────────────────
# Required for authentication (Google Sign-In and Phone Auth)
# Get from: Firebase Console → Project Settings → Service Accounts
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"tinybit-d52e3","private_key":"-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk@tinybit-d52e3.iam.gserviceaccount.com"}
EXPECTED_FIREBASE_PROJECT_ID=tinybit-d52e3

# ─── AI & LLM Configuration ───────────────────────────────────────────────
# Optional: Only needed if using AI features (Sathi chatbot)
GEMINI_API_KEY=your-gemini-api-key-here

# ─── Admin Panel Configuration ────────────────────────────────────────────
# IMPORTANT: Change these in production!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ─── Server Configuration ────────────────────────────────────────────────
# SERVER_URL: Public URL of this server (used for QR codes, email links)
SERVER_URL=http://localhost:5000
